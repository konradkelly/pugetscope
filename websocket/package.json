{
  "name": "@pugetscope/websocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:integration": "cross-env DATABASE_URL=postgres://pugetscope:pugetscope@localhost:5433/pugetscope_test REDIS_URL=redis://localhost:6379/1 POSTGRES_SSL=false vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1101.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
