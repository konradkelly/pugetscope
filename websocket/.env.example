PORT=3001
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

# Push alerts — needs its own Postgres connection to read alert_watches /
# push_subscriptions (see db/init/001_schema.sql). Same var names as api/.
DATABASE_URL=postgres://pugetscope:pugetscope@localhost:5433/pugetscope
POSTGRES_SSL=false

# Generate with: npx web-push generate-vapid-keys
# Blank disables alert delivery (see src/config.ts).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pugetscope.com
