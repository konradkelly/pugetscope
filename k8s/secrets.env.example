POSTGRES_USER=pugetscope
POSTGRES_PASSWORD=pugetscope
POSTGRES_DB=pugetscope

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Non-AWS forward proxy for OpenSky calls only — OpenSky blocks connections
# from AWS IP ranges (see ingestion/src/config.ts). EC2-only; leave blank for
# local dev where the block doesn't apply. "http://user:pass@host:port".
OPENSKY_PROXY_URL=

# Optional — see ingestion/.env.example. Leave blank to disable FIDS enrichment.
AERODATABOX_API_KEY=

# Optional — powers the nightly digest-generate CronJob. Leave blank to
# disable AI daily digest generation (generateDigest.ts no-ops without it).
ANTHROPIC_API_KEY=

# Optional — anonymous push alerts (websocket service). Generate with:
#   npx web-push generate-vapid-keys
# Leave both blank to disable alert delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Self-hosted Umami analytics (its own dedicated Postgres, separate from the
# main app DB). UMAMI_APP_SECRET should be a long random string, e.g.:
#   openssl rand -hex 32
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=

# Grafana admin login (internal-only service, no public signup — see
# k8s/README.md Observability section).
GRAFANA_ADMIN_PASSWORD=
